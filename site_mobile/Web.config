<?xml version="1.0" encoding="UTF-8"?>

<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->

<configuration>
  
  <system.web>
    <compilation targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" />    
  </system.web>


  <system.webServer>
	<staticContent> 
		<clientCache httpExpires="Sun, 29 Mar 2020 00:00:00 GMT" cacheControlMode="UseExpires" /> 
	</staticContent>
	
	<handlers> 
<add name="freegeoipHandler" path="*http://freegeoip.net/json/" verb="*" type="System.Web.Handlers" preCondition="integratedMode" /> 
<add name="jqmiconhandler" path="*http://m.statlightglobal.com/css/jqm-icon-pack-fa.css" verb="*" type="System.Web.Handlers" preCondition="integratedMode" /> 
</handlers>
	
    <rewrite>
      <rules>
                <rule name="CanonicalHostNameRule1" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^statlightglobal\.com$" negate="true" />
                    </conditions>
                    <action type="Redirect" url="http://statlightglobal.com/{PATH_INFO}" />
                </rule>
        <rule name="Hide .html ext">
          <match ignoreCase="true" url="^(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:0}.html" />
        </rule>
        <rule name="Redirecting .html ext" stopProcessing="true">
          <match url="^(.*).html" />
          <conditions logicalGrouping="MatchAny">
            <add input="{URL}" pattern="(.*).html" />
          </conditions>
          <action type="Redirect" url="{R:1}" />
        </rule>
		<rule name="Remove multiple slashes" stopProcessing="true">
				  <match url=".*" />
				  <action type="Redirect" url="{REQUEST_URI}" />
				  <conditions>
					<add input="{UNENCODED_URL}" pattern="(.*?)[/]{2,}$" />
				  </conditions>
				</rule>
      </rules>
    </rewrite>
  </system.webServer>

  <appSettings>
    <!-- <add key="mailHost" value="relay-hosting.secureserver.net"/> -->
	<add key="mailHost" value="smtpout.asia.secureserver.net" />
	<add key="mailPort" value="25" />
    <add key="mailUser" value="info@statlightglobal.com" />
    <add key="mailPassword" value="Stat#2016!" />
    <add key="testmail" value="true" />

    <add key="replyJobSubject" value="Acknowledgement from Statlight Software Solutions." />
    <add key="replyContactSubject" value="Thank You for reaching Statlight Software Solutions" />
    <add key="contactSubject" value="!@#RequestName#@! is trying to contact" />
    <add key="jobSubject" value="!@#ApplnName#@! has applied for !@#Desig#@!." />
    <add key="siteurl" value="http://statlightglobal.com" />

    <add key="infomailid" value="info@statlightglobal.com" />
    <!--<add key="infomailid" value="ashok@statlight.in"/>-->
    <add key="infomaildisplay" value="Statlight Support" />
    <add key="jobsmailid" value="jobs@statlightglobal.com" />
    <!--<add key="jobsmailid" value="ashok@statlight.in"/>-->
    <add key="jobsmaildisplay" value="Statlight Placement Cell" />

    <add key="cntToMail" value="siva@statlight.in" />
    <add key="cntCCMail" value="mohan@statlight.in" />
    <add key="cntAddressingPerson" value="Siva" />

    <add key="eMailLogoPath" value="\img\logo.png" />
    <add key="fbLogoPath" value="\img\soc_media_icon\fb.png" />
    <add key="twLogoPath" value="\img\soc_media_icon\tw.png" />
    <add key="skLogoPath" value="\img\soc_media_icon\sk.png" />
    <add key="liLogoPath" value="\img\soc_media_icon\li.png" />
    <add key="gpLogoPath" value="\img\soc_media_icon\gp.png" />


  </appSettings>
</configuration>
